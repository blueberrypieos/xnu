#!/bin/sh
set -e
if [ "$1" = configure ] && [ -z "${DPKG_ROOT:-}" ] && [ "$(uname -s)" = Darwin ]; then
	if [ -x /usr/libexec/blueberry-pie-os-update-boot ]; then
		/usr/libexec/blueberry-pie-os-update-boot
	fi
	c=/var/db/blueberry-pie-os-kernel.configured
	sysctl -n kern.bootsessionuuid > "$c.new"
	mv "$c.new" "$c"
	rm -f /var/db/blueberry-pie-os-kernel.unpacking /var/db/blueberry-pie-os-kernel.unpacking.new
	dpkg-trigger --no-await /usr/lib/blueberry-pie-os/kernels
fi
