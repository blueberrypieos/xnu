+static void
+arm_dram_hole_add_framebuffer(boot_args *args)
+{
+	uint64_t fb = args->Video.v_baseAddr & ~1ULL;
+	uint64_t len = (uint64_t)args->Video.v_rowBytes * args->Video.v_height;
+	if (fb == 0 || len == 0) {
+		return;
+	}
+	uint64_t base = fb & ~(uint64_t)ARM_PGMASK;
+	uint64_t end = (fb + len + ARM_PGMASK) & ~(uint64_t)ARM_PGMASK;
+	if (base < gDramBase || end > gDramBase + gDramSize) {
+		return;
+	}
+	arm_dram_hole_t holes[ARM_DRAM_HOLES_MAX + 1];
+	unsigned int n = 0, i = 0;
+	for (; i < gDramHoleCount && gDramHoles[i].base + gDramHoles[i].size < base; i++) {
+		holes[n++] = gDramHoles[i];
+	}
+	for (; i < gDramHoleCount && gDramHoles[i].base <= end; i++) {
+		base = MIN(base, gDramHoles[i].base);
+		end = MAX(end, gDramHoles[i].base + gDramHoles[i].size);
+	}
+	holes[n].base = base;
+	holes[n].size = end - base;
+	n++;
+	for (; i < gDramHoleCount; i++) {
+		holes[n++] = gDramHoles[i];
+	}
+	if (n > ARM_DRAM_HOLES_MAX) {
+		kprintf("arm_init: no DRAM hole left for the framebuffer at 0x%llx\n", fb);
+		return;
+	}
+	for (i = 0; i < n; i++) {
+		gDramHoles[i] = holes[i];
+	}
+	gDramHoleCount = n;
