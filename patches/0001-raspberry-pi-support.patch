@@ -20,6 +20,7 @@
  *
  * @APPLE_LICENSE_HEADER_END@
  */
+/* Modified 2026-11-01: Raspberry Pi 4 and 5 support (APSL 2.0 section 2.2(b)). */
 #include <sys/cdefs.h>
 #include <sys/types.h>
 #include <sys/work_interval.h>
@@ -272,3 +273,98 @@ work_interval_copy_port(work_interval_t interval_handle, mach_port_t *port)
 
 	return 0;
 }
+
+struct work_interval_instance {
+	work_interval_t wii_interval;
+	uint64_t wii_start;
+	uint64_t wii_deadline;
+	uint64_t wii_finish;
+	uint64_t wii_complexity;
+};
+
+work_interval_instance_t
+work_interval_instance_alloc(work_interval_t interval_handle)
+{
+	work_interval_instance_t instance = malloc(sizeof(*instance));
+	if (instance != NULL) {
+		bzero(instance, sizeof(*instance));
+		instance->wii_interval = interval_handle;
+	}
+	return instance;
+}
+
+void
+work_interval_instance_free(work_interval_instance_t instance)
+{
+	free(instance);
+}
+
+void
+work_interval_instance_clear(work_interval_instance_t instance)
+{
+	work_interval_t interval_handle = instance->wii_interval;
+	bzero(instance, sizeof(*instance));
+	instance->wii_interval = interval_handle;
+}
+
+void
+work_interval_instance_set_start(work_interval_instance_t instance, uint64_t start)
+{
+	instance->wii_start = start;
+}
+
+void
+work_interval_instance_set_deadline(work_interval_instance_t instance, uint64_t deadline)
+{
+	instance->wii_deadline = deadline;
+}
+
+void
+work_interval_instance_set_finish(work_interval_instance_t instance, uint64_t finish)
+{
+	instance->wii_finish = finish;
+}
+
+void
+work_interval_instance_set_complexity(work_interval_instance_t instance, uint64_t complexity)
+{
+	instance->wii_complexity = complexity;
+}
+
+int
+work_interval_instance_start(work_interval_instance_t instance)
+{
+	if (instance == NULL || instance->wii_interval == NULL) {
+		errno = EINVAL;
+		return -1;
+	}
+	return 0;
+}
+
+int
+work_interval_instance_update(work_interval_instance_t instance)
+{
+	return work_interval_instance_start(instance);
+}
+
+int
+work_interval_instance_finish(work_interval_instance_t instance)
+{
+	if (instance == NULL) {
+		errno = EINVAL;
+		return -1;
+	}
+	if (instance->wii_finish == 0) {
+		instance->wii_finish = mach_absolute_time();
+	}
+	return work_interval_notify(instance->wii_interval, instance->wii_start,
+	           instance->wii_finish, instance->wii_deadline, 0, 0);
+}
+
+void
+work_interval_instance_get_telemetry_data(work_interval_instance_t instance,
+    work_interval_data_t data, size_t size)
+{
+	(void)instance;
+	bzero(data, size);
+}
