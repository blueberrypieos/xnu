+		if (pte_p == PT_ENTRY_NULL || !pte_is_valid(*pte_p) ||
+		    (*pte_p & ARM_PTE_HINT_MASK)) {
+			kr = KERN_FAILURE;
+			break;
+		}
+		pa = pte_to_pa(*pte_p);
+		managed = pa_valid(pa);
+		if (managed) {
+			pai = pa_index(pa);
+			pvh_lock(pai);
+		}
+		spte = *pte_p;
+
+		tmplate = (spte & ~(ARM_PTE_APMASK | ARM_PTE_PNX)) | ARM_PTE_NX |
+		    ARM_PTE_AP((prot & VM_PROT_WRITE) ? AP_RWNA : AP_RONA);
+		if (!exec) {
+			tmplate |= ARM_PTE_PNX;
+		}
+		pte_set_was_writeable(tmplate, false);
+		if (exec) {
+			tables += pmap_kext_allow_exec_above(va);
+		}
+
+		if (managed) {
+			pv_entry_t **pvh = pai_to_pvh(pai);
+			const vm_offset_t pvh_flags = pvh_get_flags(pvh);
+
+			if (exec && !(pvh_flags & PVH_FLAG_EXEC)) {
+				if (pmap_kext_ptov_is_page(pa)) {
+					pvh_set_flags(pvh, pvh_flags | PVH_FLAG_EXEC);
+					pmap_set_ptov_ap(pai, AP_RONA, TRUE);
+				} else {
+					aliased++;
