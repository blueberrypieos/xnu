+	uint32_t other_offset = h->eph_other_log_offset;
+	uint32_t other_len = pe_panic_region_text(other_offset, h->eph_other_log_len);
+	if (other_len != 0 && other_offset > log_offset && other_offset - log_offset < log_len) {
