+static struct {
+	void (*paint_char)(unsigned int, unsigned int, unsigned char, int, unsigned char, int);
+	void (*clear_screen)(unsigned int, unsigned int, unsigned int, unsigned int, int);
+	void (*scroll_down)(int, unsigned int, unsigned int);
+	void (*scroll_up)(int, unsigned int, unsigned int);
+	void (*hide_cursor)(unsigned int, unsigned int);
+	void (*show_cursor)(unsigned int, unsigned int);
+} gc_ops_drawing;
+
+static void
+gc_ops_mute(void)
+{
+	if (gc_ops.paint_char != gc_null_paint_char) {
+		gc_ops_drawing.paint_char   = gc_ops.paint_char;
+		gc_ops_drawing.clear_screen = gc_ops.clear_screen;
+		gc_ops_drawing.scroll_down  = gc_ops.scroll_down;
+		gc_ops_drawing.scroll_up    = gc_ops.scroll_up;
+		gc_ops_drawing.hide_cursor  = gc_ops.hide_cursor;
+		gc_ops_drawing.show_cursor  = gc_ops.show_cursor;
+	}
+	gc_ops.paint_char   = gc_null_paint_char;
+	gc_ops.clear_screen = gc_null_clear_screen;
+	gc_ops.scroll_down  = gc_null_scroll;
+	gc_ops.scroll_up    = gc_null_scroll;
+	gc_ops.hide_cursor  = gc_null_cursor;
+	gc_ops.show_cursor  = gc_null_cursor;
+}
+
+static void
+gc_ops_unmute(void)
+{
+	if (gc_ops.paint_char == gc_null_paint_char) {
+		gc_ops.paint_char   = gc_ops_drawing.paint_char;
+		gc_ops.clear_screen = gc_ops_drawing.clear_screen;
+		gc_ops.scroll_down  = gc_ops_drawing.scroll_down;
+		gc_ops.scroll_up    = gc_ops_drawing.scroll_up;
+		gc_ops.hide_cursor  = gc_ops_drawing.hide_cursor;
+		gc_ops.show_cursor  = gc_ops_drawing.show_cursor;
+	}
+}
+
+static void
+gc_repaint(void)
+{
+	unsigned char code = gc_color_code;
+	unsigned int x, y;
+	int painted = -1;
+
+	if (!vinfo.v_depth || gc_ops.paint_char == NULL || gc_ops.paint_char == gc_null_paint_char) {
+		return;
+	}
+	gc_ops.update_color(COLOR_BACKGROUND, FALSE);
+	gc_ops.clear_screen(0, 0, 0, vinfo.v_rows, 2);
+	for (y = 0; y < gc_buffer_rows && y < vinfo.v_rows; y++) {
+		for (x = 0; x < gc_buffer_columns && x < vinfo.v_columns; x++) {
+			uint32_t i = y * gc_buffer_columns + x;
+			unsigned char c = gc_buffer_colorcodes[i];
+			if (c != painted) {
+				gc_ops.update_color(COLOR_CODE_GET(c, TRUE), TRUE);
+				gc_ops.update_color(COLOR_CODE_GET(c, FALSE), FALSE);
+				painted = c;
+			}
+			gc_ops.paint_char(x, y, gc_buffer_characters[i], gc_buffer_attributes[i], 0, 0);
+		}
+	}
+	gc_ops.update_color(COLOR_CODE_GET(code, TRUE), TRUE);
+	gc_ops.update_color(COLOR_CODE_GET(code, FALSE), FALSE);
+	gc_color_code = code;
+	gc_show_cursor(gc_x, gc_y);
+}
+
+static uint32_t
+vc_pixel_convert(uint32_t v, unsigned int from, unsigned int to)
+{
+	uint32_t r, g, b;
+
+	if (from == to) {
+		return v;
+	}
+	if (from == 16) {
+		r = (v >> 11) & 0x1f;
+		g = (v >> 5) & 0x3f;
+		b = v & 0x1f;
+		return ((r << 3 | r >> 2) << 16) | ((g << 2 | g >> 4) << 8) | (b << 3 | b >> 2);
+	}
+	return ((v >> 8) & 0xf800) | ((v >> 5) & 0x07e0) | ((v >> 3) & 0x001f);
+}
+
+static void
+vc_copy_screen(const struct vc_info *from)
+{
+	unsigned int w = MIN(from->v_width, vinfo.v_width);
+	unsigned int h = MIN(from->v_height, vinfo.v_height);
+
+	if (from->v_baseaddr == 0 || (from->v_depth != 16 && from->v_depth != 32)) {
+		return;
+	}
+	for (unsigned int y = 0; y < h; y++) {
+		const volatile char *src = (const volatile char *)(from->v_baseaddr + y * from->v_rowbytes);
+		volatile char *dst = (volatile char *)(vinfo.v_baseaddr + y * vinfo.v_rowbytes);
+		for (unsigned int x = 0; x < w; x++) {
+			uint32_t v = from->v_depth == 16 ? ((const volatile uint16_t *)src)[x] :
+			    ((const volatile uint32_t *)src)[x];
+			v = vc_pixel_convert(v, from->v_depth, vinfo.v_depth);
+			if (vinfo.v_depth == 16) {
+				((volatile uint16_t *)dst)[x] = (uint16_t)v;
+			} else {
+				((volatile uint32_t *)dst)[x] = v;
+			}
+		}
+	}
+}
+
+static vm_offset_t pie_takeover_map;
+static vm_size_t pie_takeover_map_size;
+
+int
+pie_console_takeover(const PE_Video *video, bool copy)
+{
+	unsigned int depth, width, height, rowbytes, cols, rows, n;
+	vm_offset_t virt, map = 0, oldmap;
+	vm_size_t mapsize = 0, oldmapsize;
+	uint64_t phys = 0;
+	unsigned char *attrs, *chars, *codes, *tabs, *font;
+	unsigned int font_char_size, font_size;
+	struct {
+		unsigned char *attrs, *chars, *codes, *tabs;
+		uint32_t cols, size;
+		unsigned char *font;
+		uint32_t font_size;
+	} old;
+
+	if (video == NULL || !gc_initialized || !vm_initialized) {
+		return EINVAL;
+	}
+	depth = (unsigned int)video->v_depth;
+	width = (unsigned int)video->v_width;
+	height = (unsigned int)video->v_height;
+	rowbytes = (unsigned int)video->v_rowBytes;
+	if ((depth != 16 && depth != 32) || width < ISO_CHAR_WIDTH || height < ISO_CHAR_HEIGHT ||
+	    rowbytes < width * (depth / 8) || video->v_baseAddr == 0) {
+		return EINVAL;
+	}
+
+	if (video->v_baseAddr & 1) {
+		phys = video->v_baseAddr & ~3UL;
+		mapsize = video->v_length != 0 ? video->v_length : (vm_size_t)height * rowbytes;
+		mapsize += video->v_offset;
+		virt = ml_io_map_unmappable((vm_offset_t)phys, mapsize, VM_WIMG_WCOMB);
+		map = trunc_page(virt);
+		mapsize = round_page(mapsize + (phys & PAGE_MASK));
+	} else {
+		virt = video->v_baseAddr;
+	}
+
+	cols = width / ISO_CHAR_WIDTH;
+	rows = height / ISO_CHAR_HEIGHT;
+	n = cols * rows;
+	attrs = kalloc_data(n, Z_WAITOK);
+	chars = kalloc_data(n, Z_WAITOK);
+	codes = kalloc_data(n, Z_WAITOK);
+	tabs = kalloc_data(cols, Z_WAITOK);
+	font_char_size = ISO_CHAR_HEIGHT * ((depth / 8) * ISO_CHAR_WIDTH);
+	font_size = (ISO_CHAR_MAX - ISO_CHAR_MIN + 1) * font_char_size;
+	font = kalloc_data(font_size, Z_WAITOK);
+	if (attrs == NULL || chars == NULL || codes == NULL || tabs == NULL || font == NULL) {
+		kfree_data(attrs, n);
+		kfree_data(chars, n);
+		kfree_data(codes, n);
+		kfree_data(tabs, cols);
+		kfree_data(font, font_size);
+		if (map != 0) {
+			ml_io_unmap(map, mapsize);
+		}
+		return ENOMEM;
+	}
+	for (unsigned int c = ISO_CHAR_MIN; c <= ISO_CHAR_MAX; c++) {
+		vc_render_char((unsigned char)c, font + c * font_char_size, (short)depth);
+	}
+	memset(attrs, ATTR_NONE, n);
+	memset(chars, ' ', n);
+	memset(codes, COLOR_CODE_SET(0, COLOR_FOREGROUND, TRUE), n);
+	memset(tabs, 0, cols);
+
+	VCPUTC_LOCK_LOCK();
+	struct vc_info from = vinfo;
+
+	simple_lock(&vc_progress_lock, LCK_GRP_NULL);
+	vinfo.v_width = width;
+	vinfo.v_height = height;
+	vinfo.v_depth = depth;
+	vinfo.v_rowbytes = rowbytes;
+	vinfo.v_baseaddr = virt + video->v_offset;
+	vinfo.v_physaddr = phys;
+	vinfo.v_type = 0;
+	vc_initialize(&vinfo);
+	vc_rgb565 = (depth == 16);
+	simple_unlock(&vc_progress_lock);
+
+	old.font = vc_rendered_font;
+	old.font_size = vc_rendered_font_size;
+	vc_rendered_font = font;
+	vc_rendered_font_size = font_size;
+	vc_rendered_char_size = (int)font_char_size;
+	vc_rendered_font_depth = (short)depth;
+
+	old.attrs = gc_buffer_attributes;
+	old.chars = gc_buffer_characters;
+	old.codes = gc_buffer_colorcodes;
+	old.tabs = gc_buffer_tab_stops;
+	old.cols = gc_buffer_columns;
+	old.size = gc_buffer_size;
+	if (gc_buffer_size != 0) {
+		if (copy) {
+			unsigned int shift = gc_y >= rows ? gc_y - rows + 1 : 0;
+			unsigned int ncols = MIN(cols, gc_buffer_columns);
+			for (unsigned int r = 0; r < rows && r + shift < gc_buffer_rows; r++) {
+				uint32_t src = (r + shift) * gc_buffer_columns, dst = r * cols;
+				memcpy(attrs + dst, gc_buffer_attributes + src, ncols);
+				memcpy(chars + dst, gc_buffer_characters + src, ncols);
+				memcpy(codes + dst, gc_buffer_colorcodes + src, ncols);
+			}
+			gc_y -= shift;
+			gc_savey = gc_savey >= shift ? gc_savey - shift : 0;
+		} else {
+			gc_x = gc_y = 0;
+		}
+		gc_buffer_attributes = attrs;
+		gc_buffer_characters = chars;
+		gc_buffer_colorcodes = codes;
+		gc_buffer_tab_stops = tabs;
+		gc_buffer_columns = cols;
+		gc_buffer_rows = rows;
+		gc_buffer_size = n;
+		gc_reset_tabs();
+	} else {
+		old.attrs = attrs;
+		old.chars = chars;
+		old.codes = codes;
+		old.tabs = tabs;
+		old.cols = cols;
+		old.size = n;
+		if (!copy) {
+			gc_x = gc_y = 0;
+		}
+	}
+	gc_x = MIN(gc_x, cols - 1);
+	gc_y = MIN(gc_y, rows - 1);
+	gc_savex = MIN(gc_savex, cols - 1);
+	gc_savey = MIN(gc_savey, rows - 1);
+	gc_scrreg_top = 0;
+	gc_scrreg_bottom = rows;
+	gc_ops.update_color(COLOR_CODE_GET(gc_color_code, TRUE), TRUE);
+	gc_ops.update_color(COLOR_CODE_GET(gc_color_code, FALSE), FALSE);
+
+	if (!pie_graphics) {
+		if (gc_buffer_size != 0) {
+			gc_repaint();
+		} else if (copy) {
+			vc_copy_screen(&from);
+		} else if (gc_ops.clear_screen != NULL) {
+			gc_ops.update_color(COLOR_BACKGROUND, FALSE);
+			gc_ops.clear_screen(0, 0, 0, vinfo.v_rows, 2);
+			gc_ops.update_color(COLOR_CODE_GET(gc_color_code, FALSE), FALSE);
+		}
+	}
+
+	oldmap = pie_takeover_map;
+	oldmapsize = pie_takeover_map_size;
+	pie_takeover_map = map;
+	pie_takeover_map_size = mapsize;
+	VCPUTC_LOCK_UNLOCK();
+
+	kfree_data(old.attrs, old.size);
+	kfree_data(old.chars, old.size);
+	kfree_data(old.codes, old.size);
+	kfree_data(old.tabs, old.cols);
+	kfree_data(old.font, old.font_size);
+	if (oldmap != 0) {
+		ml_io_unmap(oldmap, oldmapsize);
+	}
+	return 0;
+}
+
+void
+pie_console_set_graphics(bool graphics)
+{
+	if (!gc_initialized) {
+		pie_graphics = graphics;
+		return;
+	}
+	VCPUTC_LOCK_LOCK();
+	if (graphics != pie_graphics) {
+		pie_graphics = graphics;
+		if (graphics) {
+			gc_ops_mute();
+		} else {
+			gc_ops_unmute();
+			if (gc_enabled && gc_buffer_size != 0) {
+				gc_repaint();
+			}
+		}
+	}
+	VCPUTC_LOCK_UNLOCK();
+}
+
+bool
+pie_console_graphics(void)
+{
+	return pie_graphics;
+}
+
+static pie_panic_display_fn_t pie_panic_display;
+
+void
+pie_panic_display_register(pie_panic_display_fn_t fn)
+{
+	os_atomic_store(&pie_panic_display, fn, release);
+}
+
+void pie_console_panic(void);
+void
+pie_console_panic(void)
+{
+	static bool entered;
+	pie_panic_display_fn_t fn;
+
+	if (entered) {
+		return;
+	}
+	entered = true;
+	fn = os_atomic_load(&pie_panic_display, acquire);
+	if (fn != NULL) {
+		fn();
+	}
+	if (pie_graphics) {
+		pie_graphics = false;
+		gc_ops_unmute();
+		if (gc_buffer_size != 0) {
+			gc_repaint();
+		}
+	}
+}
+#endif
