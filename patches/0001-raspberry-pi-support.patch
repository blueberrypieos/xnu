+		return KERN_PROTECTION_FAILURE;
+	}
+	if (!(prot & VM_PROT_READ) || ((start | size) & PAGE_MASK) || end < start) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	if (g_kext_map == kernel_map || start < vm_map_min(g_kext_map) ||
+	    end > vm_map_max(g_kext_map)) {
+		return KERN_INVALID_ADDRESS;
+	}
+	assert(pt_attr_page_size(pmap_get_pt_attr(kernel_pmap)) * PAGE_RATIO == PAGE_SIZE);
+
+	pmap_lock(kernel_pmap, PMAP_LOCK_EXCLUSIVE);
+	for (va = start; va < end; va += PAGE_SIZE) {
+		pt_entry_t *pte_p = pmap_pte(kernel_pmap, va);
+		pt_entry_t spte, tmplate;
+		pmap_paddr_t pa;
+		unsigned int pai = 0;
+		bool managed;
