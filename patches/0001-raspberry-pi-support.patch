+			} else if (!exec && (pvh_flags & PVH_FLAG_EXEC)) {
+				pvh_set_flags(pvh, pvh_flags & ~PVH_FLAG_EXEC);
+				pmap_set_ptov_ap(pai, AP_RWNA, TRUE);
+			}
+		}
+
+		write_pte_strong(pte_p, tmplate);
+
+		if (managed) {
+			pvh_unlock(pai);
+		}
+	}
+	FLUSH_PTE_STRONG();
+	PMAP_UPDATE_TLBS(kernel_pmap, start, va, false, tables == 0);
+	pmap_unlock(kernel_pmap, PMAP_LOCK_EXCLUSIVE);
+
+	if (aliased) {
+		printf("pmap_kext_protect: %u pages of [%p, %p) keep a writable "
+		    "physical aperture alias\n", aliased, (void *)start, (void *)end);
+	}
+	return kr;
+}
