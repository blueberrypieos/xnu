 /*
  *
@@ -393,6 +394,10 @@ process_name(const char *s, proc_t p)
 #if CONFIG_BUILTIN_HFS
 extern void hfs_builtin_init(void);
 #endif
+#include <config_builtin_zfs.h>
+#if CONFIG_BUILTIN_ZFS
+extern void zfs_builtin_init(void);
+#endif
 struct rlimit vm_initial_limit_stack = { .rlim_cur = DFLSSIZ, .rlim_max = MAXSSIZ - PAGE_MAX_SIZE };
 struct rlimit vm_initial_limit_data = { .rlim_cur = DFLDSIZ, .rlim_max = MAXDSIZ };
 struct rlimit vm_initial_limit_core = { .rlim_cur = DFLCSIZ, .rlim_max = MAXCSIZ };
@@ -711,6 +716,9 @@ bsd_init(void)
 #if CONFIG_BUILTIN_HFS
 	hfs_builtin_init();
 #endif
+#if CONFIG_BUILTIN_ZFS
+	zfs_builtin_init();
+#endif
 
 #if CONFIG_PROC_UUID_POLICY
 	/* Initial proc_uuid_policy subsystem */
