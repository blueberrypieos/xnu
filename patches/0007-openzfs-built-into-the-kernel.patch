+# Modified 2026-11-14: OpenZFS built into the kernel.
 
 OPTIONS/config_macf			optional config_macf
 OPTIONS/config_builtin_hfs		optional config_builtin_hfs
+OPTIONS/config_builtin_zfs		optional config_builtin_zfs
 OPTIONS/config_rpi			optional config_rpi
 OPTIONS/mach_assert			optional mach_assert
 OPTIONS/mach_ldebug			optional mach_ldebug
@@ -385,6 +387,7 @@ bsd/security/audit/audit_worker.c		optional config_audit
 bsd/pthread/pthread_shims.c		standard
 bsd/pthread/pthread_builtin.c	optional config_builtin_pthread
 bsd/vfs/vfs_hfs_builtin.c		optional config_builtin_hfs
+bsd/vfs/vfs_zfs_builtin.c		optional config_builtin_zfs
 bsd/pthread/pthread_priority.c		standard
 bsd/pthread/pthread_workqueue.c		standard
 
