 # Ensure all denylisted files exist. Paths with wildcards are ignored.
 # Run against a denylist with fully-qualified paths.
@@ -21,7 +38,6 @@
 for f in $denylist_files ; do
 	if ! [[ -e $f ]] ; then
 		echo "KASan: denylisted file $f not found" >&2
-		ret=1
 	fi
 done
 
