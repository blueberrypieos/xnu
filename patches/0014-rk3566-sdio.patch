 /* Modified 2026-11-19: Rockchip RK3566 I2C, PMIC, USB 2 PHY and EHCI drivers (APSL 2.0 section 2.2(b)). */
 /* Modified 2026-11-20: SDIO on the Raspberry Pi 4 and 5 (APSL 2.0 section 2.2(b)). */
+/* Modified 2026-11-24: SDIO on the RG353V internal wireless slot (APSL 2.0 section 2.2(b)). */
 /*
  * NOTICE: This file was modified by SPARTA, Inc. in 2005 to introduce
  * support for mandatory and extensible security protections.  This notice
@@ -77,6 +78,12 @@
     "     'IOClass'         = RPiSDHCISDIO;"
     "     'IOProviderClass' = IOPlatformDevice;"
     "     'IONameMatch'     = ('brcm,bcm2835-sdhci', 'brcm,bcm2712-sdhci');"
+    "     'IOProbeScore'    = 1000:32;"
+    "   },"
+    "   {"
+    "     'IOClass'         = RKDWMMSDIO;"
+    "     'IOProviderClass' = IOPlatformDevice;"
+    "     'IONameMatch'     = 'rockchip,rk3568-dw-mshc';"
     "     'IOProbeScore'    = 1000:32;"
     "   },"
     "   {"
