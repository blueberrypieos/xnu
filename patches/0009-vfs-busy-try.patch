@@ -1074,6 +1075,30 @@
 	}
 	return 0;
 }
+
+int
+vfs_busy_try(mount_t mp)
+{
+	if (mp->mnt_lflag & MNT_LDEAD) {
+		return ENOENT;
+	}
+
+	mount_lock(mp);
+	if (mp->mnt_lflag & MNT_LUNMOUNT) {
+		mount_unlock(mp);
+		return ENOENT;
+	}
+	mount_unlock(mp);
+
+	if (!lck_rw_try_lock_shared(&mp->mnt_rwlock)) {
+		return EBUSY;
+	}
+	if (mp->mnt_lflag & (MNT_LDEAD | MNT_LUNMOUNT)) {
+		lck_rw_done(&mp->mnt_rwlock);
+		return ENOENT;
+	}
+	return 0;
+}
 
