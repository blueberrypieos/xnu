 /*****************************************************************************/
 
+#ifdef DW8250_UART
+
+#define DW8250_RBR              0
+#define DW8250_THR              0
+#define DW8250_LSR              5
+#define DW8250_LSR_DR           (1u << 0)
+#define DW8250_LSR_THRE         (1u << 5)
+
+static vm_offset_t dw8250_base;
+static uint32_t dw8250_shift;
+
+static unsigned int
+dw8250_uart_transmit_ready(void)
+{
+	return ml_io_read32(dw8250_base + (DW8250_LSR << dw8250_shift)) & DW8250_LSR_THRE;
+}
+
+static void
+dw8250_uart_transmit_data(uint8_t c)
+{
+	ml_io_write32(dw8250_base + (DW8250_THR << dw8250_shift), c);
+}
+
+static unsigned int
+dw8250_uart_receive_ready(void)
+{
+	return ml_io_read32(dw8250_base + (DW8250_LSR << dw8250_shift)) & DW8250_LSR_DR;
+}
+
+static uint8_t
+dw8250_uart_receive_data(void)
+{
+	return (uint8_t)ml_io_read32(dw8250_base + (DW8250_RBR << dw8250_shift));
+}
+
+static void
+dw8250_uart_init(void)
+{
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) dw8250_uart_serial_functions =
+{
+	.init = dw8250_uart_init,
+	.transmit_ready = dw8250_uart_transmit_ready,
+	.transmit_data = dw8250_uart_transmit_data,
+	.receive_ready = dw8250_uart_receive_ready,
+	.receive_data = dw8250_uart_receive_data,
+	.device = SERIAL_DW8250_UART
+};
+
+static void
+dw8250_uart_setup(const DeviceTreeNode *const devicetree_node)
+{
+	const struct {
+		uint64_t block_offset;
+		uint64_t block_size;
+	} *reg;
+	unsigned int reg_size;
+	if (SecureDTGetProperty(devicetree_node, "reg", (const void **)&reg, &reg_size) != kSuccess ||
+	    reg_size < sizeof(*reg)) {
+		panic("Unable to find the 'reg' property on the 8250 UART devicetree node");
+	}
+	const uint32_t *shift;
+	unsigned int shift_size;
+	if (SecureDTGetProperty(devicetree_node, "reg-shift", (const void **)&shift, &shift_size) == kSuccess &&
+	    shift_size == sizeof(*shift)) {
+		dw8250_shift = OSSwapBigToHostInt32(*shift);
+	}
+	const vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+	dw8250_base = ml_io_map(soc_base_phys + reg->block_offset, reg->block_size);
+	register_serial_functions(&dw8250_uart_serial_functions);
+}
+
+#endif /* DW8250_UART */
+
+/*****************************************************************************/
+
+#define RAMCONS_SIG             0x43474244u
+#define RAMCONS_HDR             12
+
+static vm_offset_t ramcons_base;
+static uint32_t ramcons_cap;
+static uint32_t ramcons_lock;
+
+static unsigned int
+ramcons_transmit_ready(void)
+{
+	return 1;
+}
+
+/*
+ * The console's writers, kprintf's and the console's own, do not share a
+ * lock: this one keeps the header in step, with interrupts off while it is
+ * held. A writer that cannot get it in a bounded time, as when a CPU
+ * stopped by a panic holds it, writes anyway.
+ */
+static void
+ramcons_transmit_data(uint8_t c)
+{
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	bool locked = false;
+	for (unsigned int i = 0; i < 100000 && !locked; i++) {
+		locked = os_atomic_cmpxchg(&ramcons_lock, 0, 1, acquire);
+	}
+	volatile uint32_t *hdr = (volatile uint32_t *)ramcons_base;
+	uint32_t start = hdr[1], size = hdr[2];
+	if (start >= ramcons_cap) {
+		start = 0;
+	}
+	*(volatile uint8_t *)(ramcons_base + RAMCONS_HDR + start) = c;
+	hdr[1] = start + 1 == ramcons_cap ? 0 : start + 1;
+	hdr[2] = size < ramcons_cap ? size + 1 : ramcons_cap;
+	if (locked) {
+		os_atomic_store(&ramcons_lock, 0, release);
+	}
+	ml_set_interrupts_enabled(istate);
+}
+
+static unsigned int
+ramcons_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+ramcons_receive_data(void)
+{
+	return 0;
+}
+
+static void
+ramcons_init(void)
+{
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) ramcons_serial_functions =
+{
+	.init = ramcons_init,
+	.transmit_ready = ramcons_transmit_ready,
+	.transmit_data = ramcons_transmit_data,
+	.receive_ready = ramcons_receive_ready,
+	.receive_data = ramcons_receive_data,
+	.device = SERIAL_RAMCONS
+};
+
+/*
+ * The console also goes to the RAM console pieboot started, if any, which
+ * survives a warm reset for the next boot to read.
+ */
+static void
+ramcons_setup(void)
+{
+	DTEntry chosen;
+	const uint64_t *range;
+	unsigned int size;
+
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "pieboot,ramcons", (const void **)&range, &size) != kSuccess ||
+	    size != 2 * sizeof(uint64_t) || range[1] <= RAMCONS_HDR || range[1] > 0x10000000) {
+		return;
+	}
+	ramcons_base = ml_io_map(range[0], range[1]);
+	ramcons_cap = (uint32_t)(range[1] - RAMCONS_HDR);
+	volatile uint32_t *hdr = (volatile uint32_t *)ramcons_base;
+	if (hdr[0] != RAMCONS_SIG || hdr[1] >= ramcons_cap || hdr[2] > ramcons_cap) {
+		hdr[0] = RAMCONS_SIG;
+		hdr[1] = 0;
+		hdr[2] = 0;
+	}
+	register_serial_functions(&ramcons_serial_functions);
+}
+
