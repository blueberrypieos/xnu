Description: Mount small FAT32 volumes as FAT32
 A volume whose boot sector has FAT32's layout is FAT32 whatever its
 cluster count, as mkfs.fat makes such small volumes.
Author: The Blueberry Pie OS Authors
Forwarded: not-needed
Last-Update: 2026-11-08

diff --git a/src/msdosfs/msdosfs.kextproj/msdosfs.kmodproj/msdosfs_vfsops.c b/src/msdosfs/msdosfs.kextproj/msdosfs.kmodproj/msdosfs_vfsops.c
index b7e1bf1..ba72815 100644
--- a/src/msdosfs/msdosfs.kextproj/msdosfs.kmodproj/msdosfs_vfsops.c
+++ b/src/msdosfs/msdosfs.kextproj/msdosfs.kmodproj/msdosfs_vfsops.c
@@ -20,6 +20,7 @@
  * 
  * @APPLE_LICENSE_HEADER_END@
  */
+/* Modified 2026-11-01: a volume with FAT32's layout is FAT32 whatever its cluster count (APSL 2.0 section 2.2(b)). */
 /* $FreeBSD: src/sys/msdosfs/msdosfs_vfsops.c,v 1.63 2000/05/05 09:58:36 phk Exp $ */
 /*	$NetBSD: msdosfs_vfsops.c,v 1.51 1997/11/17 15:36:58 ws Exp $	*/
 
@@ -598,7 +599,14 @@ int msdosfs_mount(vnode_t devvp, struct mount *mp, vfs_context_t context)
 	/*
 	 * Figure out the FAT type based on the number of clusters.
 	 */
-	if (pmp->pm_maxcluster < (CLUST_RSRVD & FAT12_MASK))
+	if (getuint16(b50->bpbFATsecs) == 0 && pmp->pm_RootDirEnts == 0 &&
+		pmp->pm_maxcluster < (CLUST_RSRVD & FAT32_MASK))
+	{
+		pmp->pm_fatmask = FAT32_MASK;
+		pmp->pm_fatmult = 4;
+		pmp->pm_fatdiv = 1;
+	}
+	else if (pmp->pm_maxcluster < (CLUST_RSRVD & FAT12_MASK))
 	{
 		pmp->pm_fatmask = FAT12_MASK;
 		pmp->pm_fatmult = 3;
