 		dprintf("couldn't add dataset");
-		provider->release();
-		return (ENXIO);
+		error = ENXIO;
 	}
-
 	provider->release();
-	return (0);
+out:
+	OSCompareAndSwap(1, 0, &zfs_osx_proxy_creating);
+	return (error);
