@@ -579,30 +580,45 @@ zfs_osx_proxy_remove(const char *osname)
  * Return:
  * 0 on success, or positive int on error.
  */
+static volatile UInt32 zfs_osx_proxy_creating = 0;
+
 int
 zfs_osx_proxy_create(const char *osname)
 {
 	ZFSDatasetScheme *provider = NULL;
+	ZFSDataset *existing;
+	int error = 0;
 
 	if (!osname || osname[0] == '\0') {
 		dprintf("missing dataset argument");
 		return (EINVAL);
 	}
 
+	if (!OSCompareAndSwap(0, 1, &zfs_osx_proxy_creating))
+		return (EBUSY);
+
+	existing = zfs_osx_proxy_get(osname);
+	if (existing != NULL) {
+		existing->release();
+		error = EEXIST;
+		goto out;
+	}
+
 	provider = zfs_osx_proxy_scheme_by_osname(osname);
 	if (provider == NULL) {
 		dprintf("can't get pool proxy");
-		return (ENOENT);
+		error = ENOENT;
+		goto out;
 	}
 
 	if (provider->addDataset(osname) == false) {
 		dprintf("couldn't add dataset");
-		provider->release();
-		return (ENXIO);
+		error = ENXIO;
 	}
-
 	provider->release();
-	return (0);
+out:
+	OSCompareAndSwap(1, 0, &zfs_osx_proxy_creating);
+	return (error);
 }
 
 } /* extern "C" */
